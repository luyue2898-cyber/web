<style>
  :root{
    --text:#333;
    --sub:#888;
    --line:#eaeaea;
    --blue:#5588bb;
    --bg:#f8f9fa;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:"Noto Sans SC","Noto Sans KR","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    line-height:1.75;
    padding:0 20px 60px;
    -webkit-font-smoothing:antialiased;
  }

  nav{
    position:sticky;top:0;z-index:2;
    background:#fff;
    padding:16px 0;
    text-align:center;
    box-shadow:0 2px 6px rgba(0,0,0,.06);
  }
  nav a{
    margin:0 14px;
    text-decoration:none;
    color:#555;
    font-size:15px;
    padding-bottom:2px;
    border-bottom:1px solid transparent;
  }
  nav a:hover{color:var(--blue);border-bottom-color:var(--blue);}

  .container{max-width:860px;margin:40px auto;}

  section{
    background:#fff;
    padding:26px 28px;
    border-radius:12px;
    box-shadow:0 2px 8px rgba(0,0,0,.04);
    margin-bottom:28px;
  }

  h2{font-size:20px;margin-bottom:4px;font-weight:700;}
  .kr{color:var(--sub);font-size:13px;margin-bottom:14px;}
  hr{border:none;border-top:1px solid var(--line);margin:0 0 16px;}

  p{font-size:15.5px;color:#444;margin-bottom:10px;}

  .work-item{
    padding:16px 18px;
    border:1px solid var(--line);
    border-radius:10px;
    margin:12px 0 0;
    transition:.2s;
  }
  .work-item:hover{border-color:#cfdcea;background:#fafcff;}
  .work-item h4{font-size:16px;margin-bottom:6px;font-weight:500;}
  .work-item p{font-size:14.5px;color:var(--sub);margin-bottom:8px;}
  .work-item a{
    display:inline-block;
    font-size:14px;
    color:var(--blue);
    text-decoration:none;
    border-bottom:1px solid rgba(85,136,187,.4);
    padding-bottom:1px;
  }
  .work-item a:hover{color:#3d6d9c;border-bottom-color:#3d6d9c;}
  .tip{font-size:13.5px;color:var(--sub);}

  .contact-line{font-size:15.5px;margin-bottom:8px;}
  .contact-line span{color:var(--sub);font-size:14px;display:inline-block;width:72px;}

  footer{
    text-align:center;
    padding:10px 0;
    color:#999;
    font-size:13px;
  }

  @media (max-width:600px){
    body{padding:0 14px 40px;}
    section{padding:20px 18px;}
    nav a{margin:0 10px;font-size:14px;}
  }
</style>
</head>
